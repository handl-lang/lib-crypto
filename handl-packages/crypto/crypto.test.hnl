from "crypto" import * as crypto

test_sha256_empty := assert crypto.sha256("") == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
test_sha256_abc := assert crypto.sha256("abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
test_sha256_fox := assert crypto.sha256("The quick brown fox jumps over the lazy dog") == "d7a8fbb307d7809469ca9abcb0082e4f8d5651e46d3cdb762d02d0bf37c9e592"

test_md5_empty := assert crypto.md5("") == "d41d8cd98f00b204e9800998ecf8427e"
test_md5_abc := assert crypto.md5("abc") == "900150983cd24fb0d6963f7d28e17f72"
test_md5_fox := assert crypto.md5("The quick brown fox jumps over the lazy dog") == "9e107d9d372bb6826bd81d3542a419d6"

test_sha1_abc := assert crypto.sha1("abc") == "a9993e364706816aba3e25717850c26c9cd0d89d"
test_arr := assert crypto.sha256([97, 98, 99]) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
